<?xml version="1.0" encoding="utf-8"?>
<!-- Full width footer button background (primary / accent). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_accent_fill_pressed" />
            <corners android:radius="@dimen/vl_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_accent_fill" />
            <corners android:radius="@dimen/vl_control_radius" />
        </shape>
    </item>
</selector>
