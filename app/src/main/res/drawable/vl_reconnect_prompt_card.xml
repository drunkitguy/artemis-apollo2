<?xml version="1.0" encoding="utf-8"?>
<!--
    Background for the in-stream reconnect offer. Deliberately a fixed dark surface
    rather than a theme token: this card is drawn on top of game video, so it has to
    stay legible whether the app is in light or dark mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F0101014" />
    <corners android:radius="@dimen/vl_card_radius" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
