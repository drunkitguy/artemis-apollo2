<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card surface. Borderless in light mode, hairline border at night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vl_card" />
    <corners android:radius="@dimen/vl_card_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/vl_card_stroke" />
</shape>
