<?xml version="1.0" encoding="utf-8"?>
<!-- Connection test / optimal bitrate finder.

     The SurfaceView underneath is the real decode target: the test streams the host's
     Desktop for a few seconds per bitrate, so the user can see that a genuine session is
     running. The scrim and the card sit on top of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vl_background">

    <SurfaceView
        android:id="@+id/vl_bt_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/vl_bt_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vl_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="@dimen/vl_space_l"
        android:paddingEnd="@dimen/vl_space_l"
        android:paddingTop="@dimen/vl_space_xl"
        android:paddingBottom="@dimen/vl_space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vl_bt_title"
                style="@style/VlText.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vl_bt_title" />

            <TextView
                android:id="@+id/vl_bt_subtitle"
                style="@style/VlText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vl_space_xs"
                android:text="@string/vl_bt_subtitle" />

            <!-- Live progress -->
            <LinearLayout
                android:id="@+id/vl_bt_progress_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vl_space_xl"
                android:background="@drawable/vl_card_background"
                android:orientation="vertical"
                android:padding="@dimen/vl_space_xl">

                <TextView
                    android:id="@+id/vl_bt_status"
                    style="@style/VlText.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vl_bt_status_preparing" />

                <TextView
                    android:id="@+id/vl_bt_step"
                    style="@style/VlText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_s" />

                <ProgressBar
                    android:id="@+id/vl_bt_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_m"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/vl_bt_readings"
                    style="@style/VlText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_m"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- Result -->
            <LinearLayout
                android:id="@+id/vl_bt_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vl_space_l"
                android:background="@drawable/vl_card_background"
                android:orientation="vertical"
                android:padding="@dimen/vl_space_xl"
                android:visibility="gone">

                <TextView
                    android:id="@+id/vl_bt_recommended"
                    style="@style/VlText.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vl_accent" />

                <TextView
                    android:id="@+id/vl_bt_factor"
                    style="@style/VlText.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_xs" />

                <TextView
                    android:id="@+id/vl_bt_explanation"
                    style="@style/VlText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_m"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/vl_bt_ladder_header"
                    style="@style/VlText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_l"
                    android:text="@string/vl_bt_ladder_header" />

                <TextView
                    android:id="@+id/vl_bt_ladder"
                    style="@style/VlText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_xs"
                    android:fontFamily="monospace"
                    android:textColor="@color/vl_label" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vl_space_l"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/vl_bt_cancel"
                    style="@style/VlText.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/vl_footer_button_neutral"
                    android:minHeight="48dp"
                    android:text="@string/vl_bt_cancel"
                    android:textColor="@color/vl_label" />

                <Button
                    android:id="@+id/vl_bt_apply"
                    style="@style/VlText.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vl_space_m"
                    android:layout_weight="1"
                    android:background="@drawable/vl_footer_button_accent"
                    android:enabled="false"
                    android:minHeight="48dp"
                    android:text="@string/vl_bt_apply" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
