<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings host. The dark ground is set here rather than in the theme so it
    applies to the fragment container without changing SettingsTheme, which the
    other settings activities also use.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stream_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    tools:context=".preferences.StreamSettings">

</RelativeLayout>
