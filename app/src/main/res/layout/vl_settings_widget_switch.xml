<?xml version="1.0" encoding="utf-8"?>
<!-- Accent-tinted switch used as the widget for VoidLink toggle rows.
     Not clickable itself: the whole preference row handles the toggle. -->
<androidx.appcompat.widget.SwitchCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@android:id/checkbox"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false"
    app:thumbTint="@color/vl_settings_switch_thumb"
    app:trackTint="@color/vl_settings_switch_track" />
