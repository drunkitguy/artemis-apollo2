<?xml version="1.0" encoding="utf-8"?>
<!--
    A discrete choice rendered as a row of segmented buttons instead of a
    dropdown. Every option is visible and one tap away, which is the point:
    a dropdown hides the alternatives behind a modal for no benefit when there
    are three or four of them.

    The buttons are added at runtime from the ListPreference entries, so this
    layout only supplies the frame.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_h_padding"
    android:paddingEnd="@dimen/settings_h_padding"
    android:paddingTop="@dimen/settings_v_padding"
    android:paddingBottom="@dimen/settings_v_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/segmented_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/settings_text_primary"
            android:textSize="@dimen/settings_title_text" />

        <TextView
            android:id="@+id/segmented_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/settings_value"
            android:textSize="@dimen/settings_value_text" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/segmented_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/segmented_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_segment_min_height"
            android:orientation="horizontal"
            android:background="@drawable/settings_segment_track"
            android:padding="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/segmented_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/settings_text_secondary"
        android:textSize="@dimen/settings_summary_text"
        android:visibility="gone" />

</LinearLayout>
