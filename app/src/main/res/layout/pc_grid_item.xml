<?xml version="1.0" encoding="utf-8"?>
<!--
    VoidLink host card.

    The outer FrameLayout is the grid cell: its padding provides the gutter
    between cards and the room needed for the card's elevation shadow.
    descendantFocusability=blocksDescendants keeps D-pad/TV focus on the grid
    item itself (as before) while still allowing the footer button to be
    tapped directly on touch screens.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:padding="@dimen/vl_space_s">

    <LinearLayout
        android:id="@+id/vl_host_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/vl_card_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vl_space_xl"
        android:paddingTop="@dimen/vl_space_xl"
        android:paddingRight="@dimen/vl_space_xl"
        android:paddingBottom="@dimen/vl_space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded square tile with the monitor glyph and the pairing badge -->
            <FrameLayout
                android:id="@+id/grid_image_layout"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/vl_tile_neutral">

                <ImageView
                    android:id="@+id/grid_image"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/vl_ic_monitor" />

                <ProgressBar
                    android:id="@+id/grid_spinner"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/vl_accent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginRight="@dimen/vl_space_xs"
                    android:layout_marginEnd="@dimen/vl_space_xs"
                    android:layout_marginBottom="@dimen/vl_space_xs"
                    android:background="@drawable/vl_badge_circle"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/vl_ic_lock_closed"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/vl_space_l"
                android:layout_marginStart="@dimen/vl_space_l"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/grid_text"
                    style="@style/VlText.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vl_space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/vl_status_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/vl_ic_wifi" />

                    <TextView
                        android:id="@+id/vl_status_text"
                        style="@style/VlText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/vl_space_xs"
                        android:layout_marginStart="@dimen/vl_space_xs" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/vl_card_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/vl_space_l"
            android:background="@color/vl_separator" />

        <LinearLayout
            android:id="@+id/vl_card_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vl_space_l"
            android:background="@drawable/vl_footer_button_accent"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vl_space_l"
            android:paddingTop="@dimen/vl_space_m"
            android:paddingRight="@dimen/vl_space_l"
            android:paddingBottom="@dimen/vl_space_m">

            <ImageView
                android:id="@+id/vl_card_action_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/vl_ic_lock_open" />

            <TextView
                android:id="@+id/vl_card_action_text"
                style="@style/VlText.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vl_space_s"
                android:layout_marginStart="@dimen/vl_space_s" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
