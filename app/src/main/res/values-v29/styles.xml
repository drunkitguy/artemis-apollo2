<resources>
    <style name="AppBaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Avoid some systems like MIUI which break the visibility of games title -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Inherits AppTheme, so the settings screens follow the VoidLink light
         chrome along with the rest of the app. -->
    <style name="SettingsTheme" parent="AppTheme">
        <!-- AppTheme descends from a dark Material base, so preference dialogs
             and popup menus would draw dark chrome over the light settings
             page. Same overlays as the pre-29 variant. -->
        <item name="alertDialogTheme">@style/VlAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/VlAlertDialogTheme</item>
        <item name="popupTheme">@style/VlPopupOverlay</item>
        <item name="actionBarPopupTheme">@style/VlPopupOverlay</item>
    </style>

    <!--
        Exactly what SettingsTheme resolved to on API 29+ before AppTheme went
        light. Used by ProfilesActivity, which still draws hardcoded light text
        and would be unreadable on a light background.
    -->
    <style name="LegacyProfilesTheme" parent="AppBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#1A1A1A</item>
        <item name="android:navigationBarColor">#1A1A1A</item>
        <item name="android:colorBackground">#1A1A1A</item>
        <item name="android:windowBackground">#1A1A1A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>