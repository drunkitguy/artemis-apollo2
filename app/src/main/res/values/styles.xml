<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.

    -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- VoidLink: light page chrome. The matching dark values are resolved
             automatically from res/values-night/voidlink_tokens.xml. -->
        <item name="android:statusBarColor">@color/vl_background</item>
        <item name="android:navigationBarColor">@color/vl_background</item>
        <!-- Deliberately left dark: AppBaseTheme is a *dark* Material theme, so
             dialogs, popup menus and the host context menu draw light text on
             ?android:colorBackground. Flipping this to a light color would make
             those unreadable. Screen backgrounds use @color/vl_background. -->
        <item name="android:colorBackground">#1A1A1A</item>
        <item name="android:windowBackground">@color/vl_background</item>
    </style>

    <!--
        Pre-restyle dark chrome. Applied to the screens that have not been
        converted to the VoidLink light palette yet, so they keep rendering
        exactly as they did before AppTheme went light. Its parent is
        AppBaseTheme (not AppTheme), so it never inherits the light system bar
        flags. Drop the android:theme from the manifest entry once a screen is
        restyled.
    -->
    <style name="LegacyDarkTheme" parent="AppBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#1A1A1A</item>
        <item name="android:navigationBarColor">#1A1A1A</item>
        <item name="android:colorBackground">#1A1A1A</item>
        <item name="android:windowBackground">#1A1A1A</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorControlHighlight">@android:color/white</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:colorControlActivated">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
        <item name="colorButtonNormal">@android:color/white</item>
    </style>

    <!--
        The settings page itself is light and token-driven, but preference
        dialogs and popup menus inherit the *activity* theme. Without these the
        list, text-entry and slider dialogs render dark AppCompat chrome on top
        of a light page. Defined once here; it is not overridden per API level,
        so it resolves everywhere SettingsTheme is used.
    -->
    <style name="VlAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/vl_accent</item>
        <item name="android:textColorPrimary">@color/vl_label</item>
        <item name="android:textColorSecondary">@color/vl_secondary_label</item>
    </style>

    <style name="VlPopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorAccent">@color/vl_accent</item>
    </style>

    <style name="SettingsTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorAccent">@color/vl_accent</item>
        <item name="alertDialogTheme">@style/VlAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/VlAlertDialogTheme</item>
        <item name="popupTheme">@style/VlPopupOverlay</item>
        <item name="actionBarPopupTheme">@style/VlPopupOverlay</item>
    </style>

    <!--
        Exactly what SettingsTheme resolves to below API 29. Used by
        ProfilesActivity, which has not been restyled and still draws hardcoded
        light text. Remove the android:theme from its manifest entry once it is.
    -->
    <style name="LegacyProfilesTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

</resources>
